# Ansible runtime and local artifacts
*.retry
logs/
.ansible/
ansible-cache/
venv/
.venv/

# Vault and secrets
vault.yml
vault.yaml
*vault*
*.vault
.vault-pass
vault-password-file
*.pem
*.key
*.csr
*.crt
*.p12
*.pfx

# Allow example and documentation files
!vault.yml.example
!*.example
!docs/**/*.pem.example

# Generated certificate material
roles/redis/files/*
!roles/redis/files/.gitkeep
roles/redis-exporter/files/*
!roles/redis-exporter/files/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

